{
  "servers": [
    {
      "id": "atlas-local",
      "name": "Atlas local tools",
      "enabled": true,
      "transport": "stdio",
      "command": "${PYTHON}",
      "args": [
        "${ROOT}/server/company_mcp.py"
      ],
      "env_keys": [],
      "allowed_tools": [
        "get_company",
        "list_skills",
        "list_files",
        "search_knowledge"
      ]
    },
    {
      "id": "microsoft-365",
      "name": "Microsoft 365",
      "enabled": false,
      "transport": "http",
