{
  "id": "crm-pipeline",
  "title": "Sales pipeline",
  "category": "Sales",
  "description": "Calculate weighted pipeline value and summarize opportunities by stage.",
  "handler": "pipeline",
  "input_schema": {
    "type": "object",
    "properties": {
      "currency": {
        "type": "string",
        "title": "Currency",
        "minLength": 1,
        "maxLength": 10000
      },
      "deals": {
        "type": "array",
        "title": "Opportunities",
        "items": {
          "type": "object",
          "properties": {
            "customer": {
              "type": "string",
              "title": "Customer",
              "minLength": 1,
              "maxLength": 10000
            },
            "stage": {
              "type": "string",
              "title": "Stage",
              "minLength": 1,
              "maxLength": 10000
            },
            "value": {
              "type": "number",
              "title": "Value",
              "minimum": 0
            },
            "probability": {
              "type": "number",
              "title": "Probability, 0 to 1",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "customer",
            "stage",
            "value",
            "probability"
          ],
          "additionalProperties": false
        },
        "maxItems": 500
      }
    },
    "required": [
      "currency",
      "deals"
    ],
    "additionalProperties": false
  },
  "example": {
    "currency": "SGD",
    "deals": [
      {
        "customer": "Example Company",
        "stage": "Proposal",
        "value": 50000,
        "probability": 0.6
      }
    ]
  },
  "guidance": "Keep currencies separate. Weighted value is a scenario calculation, not booked revenue or a forecast guarantee.",
  "effect": "local",
  "connector": null,
  "version": "1.0.0"
}
