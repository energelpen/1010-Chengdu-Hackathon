{
  "id": "calendar-event",
  "title": "Calendar invitation",
  "category": "Communication",
  "description": "Create an .ics event for Outlook, Apple Calendar or Google Calendar.",
  "handler": "calendar",
  "input_schema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Event title",
        "minLength": 1,
        "maxLength": 10000
      },
      "start": {
        "type": "string",
        "title": "Start, ISO date and time with offset",
        "minLength": 1,
        "maxLength": 10000
      },
      "end": {
        "type": "string",
        "title": "End, ISO date and time with offset",
        "minLength": 1,
        "maxLength": 10000
      },
      "description": {
        "type": "string",
        "title": "Agenda",
        "minLength": 1,
        "maxLength": 10000
      }
    },
    "required": [
      "title",
      "start",
      "end",
      "description"
    ],
    "additionalProperties": false
  },
  "example": {
    "title": "Project kickoff",
    "start": "2026-10-01T09:00:00+08:00",
    "end": "2026-10-01T10:00:00+08:00",
    "description": "Review scope, owners and milestones."
  },
  "guidance": "Require explicit time offsets and end after start. Generates a local calendar file without sending invitations.",
  "effect": "local",
  "connector": null,
  "version": "1.0.0"
}
