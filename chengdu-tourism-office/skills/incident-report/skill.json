{
  "id": "incident-report",
  "title": "Incident report",
  "category": "Operations",
  "description": "Record an incident timeline, impact, owner and recovery actions.",
  "handler": "record",
  "input_schema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Incident",
        "minLength": 1,
        "maxLength": 10000
      },
      "owner": {
        "type": "string",
        "title": "Incident owner",
        "minLength": 1,
        "maxLength": 10000
      },
      "impact": {
        "type": "string",
        "title": "Impact",
        "minLength": 1,
        "maxLength": 10000
      },
      "timeline": {
        "type": "string",
        "title": "Timeline",
        "minLength": 1,
        "maxLength": 10000
      },
      "actions": {
        "type": "array",
        "title": "Actions",
        "items": {
          "type": "object",
          "properties": {
            "task": {
              "type": "string",
              "title": "Task",
              "minLength": 1,
              "maxLength": 10000
            },
            "owner": {
              "type": "string",
              "title": "Owner",
              "minLength": 1,
              "maxLength": 10000
            },
            "due": {
              "type": "string",
              "title": "Due date",
              "minLength": 1,
              "maxLength": 10000
            }
          },
          "required": [
            "task",
            "owner",
            "due"
          ],
          "additionalProperties": false
        },
        "maxItems": 500
      }
    },
    "required": [
      "title",
      "owner",
      "impact",
      "timeline",
      "actions"
    ],
    "additionalProperties": false
  },
  "example": {
    "title": "Service interruption",
    "owner": "IT lead",
    "impact": "Customer portal unavailable for 20 minutes",
    "timeline": "09:00 detected; 09:20 restored",
    "actions": [
      {
        "task": "Review monitoring",
        "owner": "IT",
        "due": "2026-10-02"
      }
    ]
  },
  "guidance": "Distinguish observed facts from suspected causes. Do not imply remediation has happened unless supplied evidence says so.",
  "effect": "local",
  "connector": null,
  "version": "1.0.0"
}
