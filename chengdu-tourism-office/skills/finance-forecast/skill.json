{"id":"finance-forecast","title":"Monthly finance forecast","category":"Finance","description":"Forecast monthly customers, revenue, costs and operating profit from dated assumptions, with an Excel schedule.","handler":"finance_forecast","effect":"local","connector":null,"version":"1.0.0","input_schema":{"type":"object","properties":{"title":{"type":"string","minLength":1,"maxLength":100},"currency":{"type":"string","minLength":3,"maxLength":3},"opening_customers":{"type":"integer","minimum":0},"periods":{"type":"array","minItems":1,"maxItems":24,"items":{"type":"object","properties":{"month":{"type":"string","pattern":"^[0-9]{4}-(0[1-9]|1[0-2])$"},"new_customers":{"type":"integer","minimum":0},"churn":{"type":"integer","minimum":0},"revenue_per_customer":{"type":"number","minimum":0},"variable_cost_per_customer":{"type":"number","minimum":0},"fixed_cost":{"type":"number","minimum":0}},"required":["month","new_customers","churn","revenue_per_customer","variable_cost_per_customer","fixed_cost"],"additionalProperties":false}}},"required":["title","currency","opening_customers","periods"],"additionalProperties":false},"example":{"title":"Customer revenue forecast","currency":"CNY","opening_customers":20,"periods":[{"month":"2026-10","new_customers":5,"churn":1,"revenue_per_customer":3000,"variable_cost_per_customer":900,"fixed_cost":25000},{"month":"2026-11","new_customers":4,"churn":2,"revenue_per_customer":3100,"variable_cost_per_customer":950,"fixed_cost":26000}]},"guidance":"Use user-provided drivers and chronological unique months. New customers and churn are assumed evenly distributed within each month for average billable customers. Reject impossible churn; distinguish forecast from actuals."}
