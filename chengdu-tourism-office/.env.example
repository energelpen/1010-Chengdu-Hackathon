# Copy this file to .env beside app.py, then add your OpenAI API key.
# The server reads this file. Never paste the key into the chat or frontend code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Optional: reviewed Telegram updates to the boss after a completed run.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOSS_CHAT_ID=

# Demo outbound email and calendar invitations are restricted in code to
# amonsk007@gmail.com. Google Workspace uses a separate Desktop OAuth client
# and scripts/google_connect.py, not an API key in this file.
